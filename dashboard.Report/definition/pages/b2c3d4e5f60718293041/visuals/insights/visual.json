          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the data says",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#FF4D8D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Engagement rate is flat across media types — reels, images and carousels all sit near 4.2%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E8ECF5",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Performance bands separate cleanly: viral posts average ~6.8% vs ~1.7% for low posts.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E8ECF5",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Music, Fitness and Fashion lead content categories; Photography trails slightly.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E8ECF5",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  CTA posts perform at parity with non-CTA posts, so CTAs are not a growth lever here.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E8ECF5",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Timing effects are small; Tuesday and Sunday evenings show the mildest lift.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E8ECF5",
                      "fontWeight": "normal"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
