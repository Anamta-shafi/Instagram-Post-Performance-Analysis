			isDefault
			relationship: 869cf6a5-9a4b-4882-a2bd-0651b8b9b602
			defaultHierarchy: LocalDateTable_c156c1cb-85a6-41ff-b1bc-c97ea3ae093e.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column post_hour
