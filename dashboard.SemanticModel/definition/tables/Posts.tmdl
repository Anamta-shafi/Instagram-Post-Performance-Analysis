table Posts
	lineageTag: 8f2c1d4e-3a5b-4c6d-9e7f-1a2b3c4d5e6f

	measure 'Total Posts' = COUNTROWS('Posts')
		formatString: #,0
		lineageTag: 1a2b3c4d-5e6f-4a1b-8c2d-3e4f5a6b7c8d

	measure 'Total Impressions' = SUM(Posts[impressions])
		formatString: #,0
		lineageTag: 2b3c4d5e-6f7a-4b2c-9d3e-4f5a6b7c8d9e

	measure 'Total Reach' = SUM(Posts[reach])
		formatString: #,0
		lineageTag: 3c4d5e6f-7a8b-4c3d-8e4f-5a6b7c8d9e0f

	measure 'Total Interactions' = SUMX(Posts, Posts[likes] + Posts[comments] + Posts[shares] + Posts[saves])
		formatString: #,0
		lineageTag: 4d5e6f7a-8b9c-4d4e-9f5a-6b7c8d9e0f1a

	measure 'Avg Engagement Rate' = AVERAGE(Posts[engagement_rate])
		formatString: 0.00%
		lineageTag: 5e6f7a8b-9c0d-4e5f-8a6b-7c8d9e0f1a2b

	measure 'Avg Reach per Post' = DIVIDE([Total Reach], [Total Posts])
		formatString: #,0
		lineageTag: 6f7a8b9c-0d1e-4f6a-9b7c-8d9e0f1a2b3c

	measure 'Followers Gained' = SUM(Posts[followers_gained])
		formatString: #,0
		lineageTag: 7a8b9c0d-1e2f-4a7b-8c8d-9e0f1a2b3c4d

	measure 'Avg Followers per Post' = DIVIDE([Followers Gained], [Total Posts])
		formatString: 0.0
		lineageTag: 8b9c0d1e-2f3a-4b8c-9d9e-0f1a2b3c4d5e

	measure 'Viral Posts' = CALCULATE([Total Posts], Posts[performance_bucket_label] = "viral")
		formatString: #,0
		lineageTag: 9c0d1e2f-3a4b-4c9d-8e0f-1a2b3c4d5e6f

	measure 'Avg Saves' = AVERAGE(Posts[saves])
		formatString: 0.0
		lineageTag: 0d1e2f3a-4b5c-4d0e-9f1a-2b3c4d5e6f7a

	measure 'Avg Shares' = AVERAGE(Posts[shares])
		formatString: 0.0
		lineageTag: 1e2f3a4b-5c6d-4e1f-8a2b-3c4d5e6f7a8b

	measure 'Avg Likes' = AVERAGE(Posts[likes])
		formatString: 0.0
		lineageTag: 2f3a4b5c-6d7e-4f2a-9b3c-4d5e6f7a8b9c

	measure 'Avg Comments' = AVERAGE(Posts[comments])
		formatString: 0.0
		lineageTag: 3a4b5c6d-7e8f-4a3b-8c4d-5e6f7a8b9c0d

	measure 'Avg Hashtags' = AVERAGE(Posts[hashtags_count])
		formatString: 0.0
		lineageTag: 4b5c6d7e-8f9a-4b4c-9d5e-6f7a8b9c0d1e

	measure 'Avg Caption Length' = AVERAGE(Posts[caption_length])
		formatString: 0.0
		lineageTag: 5c6d7e8f-9a0b-4c5d-8e6f-7a8b9c0d1e2f

	measure 'CTA Post Share' = DIVIDE(CALCULATE([Total Posts], Posts[has_call_to_action] = TRUE()), [Total Posts])
		formatString: 0.0%
		lineageTag: 6d7e8f9a-0b1c-4d6e-9f7a-8b9c0d1e2f3a

	measure 'Engagement per 1K' = [Avg Engagement Rate] * 1000
		formatString: 0.0
		lineageTag: 7e8f9a0b-1c2d-4e7f-8a8b-9c0d1e2f3a4b

	column account_type
		dataType: string
