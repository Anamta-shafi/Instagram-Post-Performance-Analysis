	column post_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 5a6b7c8d-9e0f-4a5b-8c6d-7e8f9a0b1c2d
		summarizeBy: none
		sourceColumn: post_date

		variation Variation
			isDefault
			relationship: a54d33de-a8ae-4b28-96df-6200114a9ad4
			defaultHierarchy: LocalDateTable_115d4535-d1c6-4ef1-ab05-389a437d6410.'Date Hierarchy'

